{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Ajouté", "hidden": false },
            { "type": "fix", "section": "Corrigé", "hidden": false },
            { "type": "perf", "section": "Performance", "hidden": false },
            { "type": "refactor", "section": "Modifié", "hidden": false },
            { "type": "revert", "section": "Modifié", "hidden": false },
            { "type": "build", "section": "Modifié", "hidden": false },
            { "type": "docs", "hidden": true },
            { "type": "style", "hidden": true },
            { "type": "chore", "hidden": true },
            { "type": "ci", "hidden": true },
            { "type": "test", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nToutes les modifications notables apportées à ce projet sont documentées dans ce fichier.\n\nLe format est basé sur [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),\net ce projet respecte les règles du [Semantic Versioning](https://semver.org/spec/v2.0.0.html)."
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json", "package-lock.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
