# Exclusion par defaut : tout est ignore, on re-inclut explicitement ce qui doit etre suivi.
/*
!/.gitignore
!/.npmrc
!/.releaserc.json
!/.github/
!/src/
!/public/
!/messages/
!/package.json
!/package-lock.json
!/next.config.ts
!/next-env.d.ts
!/tsconfig.json
!/tailwind.config.ts
!/postcss.config.mjs
!/eslint.config.mjs
!/wrangler.jsonc
!/open-next.config.ts
!/README.md
!/CHANGELOG.md
!/LICENSE

# Re-exclusions a l'interieur des dossiers suivis
/public/sitemap.xml
.DS_Store
