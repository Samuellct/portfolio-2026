# Safety net for peer dependency friction between Cloudflare's own tooling
# (wrangler, @opennextjs/cloudflare) and their transitive @cloudflare/workers-types
# ranges, which have drifted across major versions in the past (see AUDIT-087,
# the now-retired @cloudflare/next-on-pages adapter hit exactly this). These are
# type-only peers with no runtime effect, so relaxing strict peer resolution is safe.
legacy-peer-deps=true
