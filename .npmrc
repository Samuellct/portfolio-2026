# @cloudflare/next-on-pages (unpinned, invoked as `npx @cloudflare/next-on-pages@1` by the
# Cloudflare Pages build) declares a peerOptional on @cloudflare/workers-types@^4.x, while our
# own `wrangler` devDependency now resolves to a version whose own peerOptional wants
# @cloudflare/workers-types@^5.x. Both are peer-optional (type declarations only, no runtime
# effect), but npm's default strict peer resolution still refuses to install with ERESOLVE.
# Tracked as AUDIT-087 (deprecated adapter, reevaluate in V6); this keeps the build unblocked
# in the meantime.
legacy-peer-deps=true
